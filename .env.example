# Copy to .env and fill in real values before running docker compose up.
# The values below are LOCAL-DEV placeholders. The prod profile refuses to start with them
# (see backend ProductionConfigValidator) — generate real ones, e.g.:  openssl rand -base64 48
DB_NAME=healthplatform
DB_USER=healthplatform
DB_PASSWORD=changeme
JWT_SECRET=change_me_to_a_random_32_plus_byte_secret

# Origin(s) of the deployed frontend, comma-separated (no wildcard). Prod: your real https origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production only: creates the very first ADMIN when the users table is empty.
# Remove both after the first start and rotate the password.
# BOOTSTRAP_ADMIN_EMAIL=admin@your-hospital.example
# BOOTSTRAP_ADMIN_PASSWORD=
